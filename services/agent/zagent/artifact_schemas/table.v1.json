{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zagent.local/schemas/views/table.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "props"],
  "properties": {
    "kind": {"const": "table"},
    "version": {"const": 1},
    "props": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "columns", "row_count"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "columns": {
          "type": "array", "minItems": 1, "maxItems": 30,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["key", "label", "type"],
            "properties": {
              "key": {"type": "string", "minLength": 1, "maxLength": 100},
              "label": {"type": "string", "minLength": 1, "maxLength": 100},
              "type": {"enum": ["string", "number", "boolean"]}
            }
          }
        },
        "rows": {
          "type": "array", "maxItems": 200,
          "items": {
            "type": "array", "maxItems": 30,
            "items": {"type": ["string", "number", "boolean", "null"], "maxLength": 4000}
          }
        },
        "handle": {"type": "string", "minLength": 1, "maxLength": 200},
        "row_count": {"type": "integer", "minimum": 0, "maximum": 10000000}
      },
      "oneOf": [{"required": ["rows"]}, {"required": ["handle"]}]
    }
  }
}