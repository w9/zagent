{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["kind", "version", "props"],
  "properties": {
    "kind": {"const": "draft_form"}, "version": {"const": 1},
    "props": {
      "type": "object", "additionalProperties": false, "required": ["title", "draft_id"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "draft_id": {"type": "string", "pattern": "^draft-[0-9]{4,}$"}
      }
    }
  }
}