{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["kind", "version", "props"],
  "properties": {
    "kind": {"const": "job_grid"}, "version": {"const": 1},
    "props": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "handle", "server", "resource_uri"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "handle": {"type": "string", "pattern": "^jobs-[0-9]{4,}$"},
        "server": {"const": "jobs"}, "resource_uri": {"const": "ui://jobs/grid"}
      }
    }
  }
}