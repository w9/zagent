[
  {
    "name": "get_document",
    "description": "Document metadata, visible versions and a section outline with line ranges.",
    "inputSchema": {
      "properties": {
        "document": {
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Document",
          "type": "string"
        }
      },
      "required": [
        "document"
      ],
      "title": "get_documentArguments",
      "type": "object"
    }
  },
  {
    "name": "lookup_term",
    "description": "Glossary definition, synonyms and the cited source of a term.",
    "inputSchema": {
      "properties": {
        "term": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Term",
          "type": "string"
        }
      },
      "required": [
        "term"
      ],
      "title": "lookup_termArguments",
      "type": "object"
    }
  },
  {
    "name": "query_reference",
    "description": "Rows of one reference table filtered by exact column values, with sources.",
    "inputSchema": {
      "properties": {
        "table": {
          "maxLength": 40,
          "pattern": "^[a-z_]+$",
          "title": "Table",
          "type": "string"
        },
        "filters": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "maxProperties": 6,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filters"
        },
        "limit": {
          "default": 10,
          "maximum": 25,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "table"
      ],
      "title": "query_referenceArguments",
      "type": "object"
    }
  },
  {
    "name": "read_document",
    "description": "Read one outline section or a line range: at most 30 lines.",
    "inputSchema": {
      "properties": {
        "document": {
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Document",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "pattern": "^[0-9]+(?:\\.[0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        }
      },
      "required": [
        "document"
      ],
      "title": "read_documentArguments",
      "type": "object"
    }
  },
  {
    "name": "search_knowledge",
    "description": "Search published knowledge at passage level with synonym expansion. Inactive (draft, superseded, retired, archived) documents are excluded unless requested.",
    "inputSchema": {
      "properties": {
        "query": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "sources": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "qms",
                  "wiki",
                  "ticketing",
                  "reference",
                  "wikipedia"
                ],
                "type": "string"
              },
              "maxItems": 5,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sources"
        },
        "doc_types": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Types"
        },
        "applies_to": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies To"
        },
        "include_inactive": {
          "default": false,
          "title": "Include Inactive",
          "type": "boolean"
        },
        "limit": {
          "default": 5,
          "maximum": 8,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "search_knowledgeArguments",
      "type": "object"
    }
  }
]
